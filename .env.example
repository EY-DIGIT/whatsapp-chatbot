# .env.example — copy to .env and fill values. DO NOT commit real secrets to the repository.
# Used by docker-compose and as a reference for Spring Boot environment overrides.

# Server / profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Postgres / JPA
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/whatsapp_bot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Flyway
SPRING_FLYWAY_ENABLED=true

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# WhatsApp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_API_TOKEN=to_set
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v22.0/{{to_set}}/messages

# Digit / OAuth (placeholders — keep secret in production)
DIGIT_TOKEN_BASIC=to_set
DIGIT_TOKEN_USERNAME=to_set
DIGIT_TOKEN_PASSWORD=to_set
DIGIT_TOKEN_SCOPE=read
DIGIT_TOKEN_GRANT_TYPE=password
DIGIT_TOKEN_USERTYPE=EMPLOYEE
DIGIT_TENANTID=mp.indore

# PGR / Digit endpoints
EGOV_PGR_SERVICE_HOST=https://urbanimcdev.eydemoapp.in/
EGOV_PGR_SEARCH_PATH=pgr-services/v2/request/_search
EGOV_PGR_CREATE_PATH=pgr-services/v2/request/_create

# Digit UI proxy endpoints (OTP / OAuth)
EGOV_USER_SERVICE_HOST=https://urbanimcdev.eydemoapp.in/
EGOV_USER_SEND_OTP_PATH=user-otp/v1/_send
EGOV_USER_TOKEN_PATH=user/oauth/token

# Digit UI form links
EGOV_FORM_HOST=https://urbanimcdev.eydemoapp.in/
EGOV_FORM_LOGIN_PATH=digit-ui/citizen/user/MobileLogin/
EGOV_FORM_GRIEVANCE_PATH=digit-ui/citizen/user/GrievanceForm/

